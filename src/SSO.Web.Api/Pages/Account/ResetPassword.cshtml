@page
@model SSO.Web.Api.Pages.Account.ResetPasswordModel
@{
	Layout = null;
	ViewData["Title"] = "Redefinir senha";
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>Redefinir senha — atNodus</title>
	<partial name="_BrandHead" />
</head>
<body>
	<div class="container-fluid min-vh-100 p-0">
		<div class="row g-0 min-vh-100">
			<aside class="col-lg-6 d-none d-lg-flex flex-column justify-content-between login-brand p-5">
				<div>
					<img class="login-brand-logo" src="~/img/brand/atnodus-logo-dark.svg" alt="atNodus" />
				</div>
				<div style="max-width: 26rem">
					<p class="brand-slogan mb-3">Conecta. Integra. Evolui.</p>
					<h1 class="font-brand display-6 fw-bold text-white mb-3">
						O núcleo que conecta o seu ecossistema.
					</h1>
					<p class="text-white-50 mb-4">
						Acesse a plataforma para integrar empresas, produtos e serviços em um grafo inteligente e seguro.
					</p>
					<div class="graph-nodes" aria-hidden="true">
						<span class="graph-node"></span>
						<span class="graph-node"></span>
						<span class="graph-node"></span>
					</div>
				</div>
				<p class="small text-white-50 mb-0">© 2026 atNodus. Todos os direitos reservados.</p>
			</aside>

			<main class="col-lg-6 d-flex flex-column justify-content-center align-items-center p-4 bg-body-tertiary">
				<div class="card shadow-sm border w-100" style="max-width: 25rem">
					<div class="card-body p-4">
						<img class="d-lg-none mb-3" src="~/img/brand/atnodus-logo.svg" alt="atNodus" style="height: 2rem" />
						<h1 class="h4 fw-bold mb-1">Redefinir senha</h1>

						@if (Model.Completed)
						{
							<p class="text-secondary small mb-4">Sua senha foi atualizada com sucesso.</p>
							<div class="alert alert-success py-2">
								Senha atualizada. Você já pode <a href="/Account/Login">entrar</a>.
							</div>
						}
						else
						{
							<p class="text-secondary small mb-4">Defina uma nova senha para a sua conta.</p>
							<form method="post">
								<input type="hidden" asp-for="Input.UserId" />
								<input type="hidden" asp-for="Input.Code" />
								<div class="mb-3">
									<label class="form-label" asp-for="Input.Password">Nova senha</label>
									<input class="form-control" asp-for="Input.Password" autocomplete="new-password" />
								</div>
								<div class="mb-3">
									<label class="form-label" asp-for="Input.ConfirmPassword">Confirmar senha</label>
									<input class="form-control" asp-for="Input.ConfirmPassword" autocomplete="new-password" />
								</div>
								@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
								{
									<div class="alert alert-danger py-2">@Model.ErrorMessage</div>
								}
								<button class="btn btn-primary btn-lg w-100" type="submit">Redefinir</button>
							</form>
						}
					</div>
				</div>
			</main>
		</div>
	</div>
	<partial name="_BrandScripts" />
</body>
</html>
