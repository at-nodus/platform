@page
@using System.Linq
@model SSO.Web.Api.Areas.Admin.Pages.MenuItemsModel
@{
	ViewData["Title"] = "Itens de menu";
}
<h1>Itens de menu</h1>
@if (!string.IsNullOrEmpty(Model.Message)) { <div class="flash">@Model.Message</div> }
@if (!string.IsNullOrEmpty(Model.Error)) { <div class="flash error">@Model.Error</div> }

@if (Model.EditId is Guid editId)
{
	<div class="card">
		<h2>Editar item de menu</h2>
		<form method="post" asp-page-handler="Update">
			<input type="hidden" name="id" value="@editId" />
			<label>Produto</label>
			<select asp-for="ProductId">
				@foreach (var p in Model.Products)
				{
					<option value="@p.Id">@p.Name</option>
				}
			</select>
			<label>Código</label>
			<input asp-for="Code" required />
			<label>Título</label>
			<input asp-for="Title" required />
			<label>Rota</label>
			<input asp-for="Route" required />
			<label>Código de permissão</label>
			<input asp-for="PermissionCode" />
			<label>Ordem</label>
			<input asp-for="SortOrder" type="number" />
			<div class="d-flex justify-content-end gap-2 mt-2 pt-3 border-top">
				<a class="btn btn-outline-secondary" asp-page="MenuItems">Cancelar</a>
				<button class="btn btn-primary" type="submit">Salvar alterações</button>
			</div>
		</form>
	</div>
}
else
{
	<div class="card">
		<h2>Novo item de menu</h2>
		<form method="post">
			<label>Produto</label>
			<select asp-for="ProductId">
				@foreach (var p in Model.Products)
				{
					<option value="@p.Id">@p.Name</option>
				}
			</select>
			<label>Código</label>
			<input asp-for="Code" required />
			<label>Título</label>
			<input asp-for="Title" required />
			<label>Rota</label>
			<input asp-for="Route" required />
			<label>Código de permissão</label>
			<input asp-for="PermissionCode" />
			<label>Ordem</label>
			<input asp-for="SortOrder" type="number" />
			<div class="d-flex justify-content-end gap-2 mt-2 pt-3 border-top">
				<button class="btn btn-primary" type="submit">Criar</button>
			</div>
		</form>
	</div>
}

<div class="card">
	<table>
		<thead><tr><th>Produto</th><th>Código</th><th>Título</th><th>Rota</th><th>Permissão</th><th>Ordem</th><th></th></tr></thead>
		<tbody>
		@foreach (var m in Model.Items)
		{
			var product = Model.Products.FirstOrDefault(x => x.Id == m.ProductId);
			<tr>
				<td>@(product?.Name ?? m.ProductId.ToString())</td>
				<td>@m.Code</td>
				<td>@m.Title</td>
				<td>@m.Route</td>
				<td>@m.PermissionCode</td>
				<td>@m.SortOrder</td>
				<td>
					<div class="d-flex gap-2 align-items-center">
						<a asp-page="MenuItems" asp-route-EditId="@m.Id">Editar</a>
						<form method="post" asp-page-handler="Delete">
							<input type="hidden" name="id" value="@m.Id" />
							<button class="btn btn-outline-secondary btn-sm" type="submit">Excluir</button>
						</form>
					</div>
				</td>
			</tr>
		}
		</tbody>
	</table>
</div>
