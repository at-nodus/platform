@model SSO.Web.Api.Areas.Admin.ViewComponents.OrganizationHubHeaderModel
@{
	var org = Model.Organization;
	var orgTitle = org is null ? "Empresa" : (!string.IsNullOrWhiteSpace(org.TradeName) ? org.TradeName : org.Name);
	var orgAddress = org is null ? "" : SSO.Core.Domain.Identity._Shared.PartyAddressFormatting.FormatAddress(org.PostalCode, org.Street, org.Number, org.Complement, org.City, org.State);
}
<nav aria-label="breadcrumb" class="mb-3">
	<ol class="breadcrumb mb-0">
		<li class="breadcrumb-item"><a href="/Admin/Organizations">Empresas</a></li>
		<li class="breadcrumb-item active" aria-current="page">@orgTitle</li>
	</ol>
</nav>
@if (org is null)
{
	<p class="text-secondary">Empresa não encontrada.</p>
}
else
{
	<div class="card border shadow-sm mb-3">
		<div class="card-body d-flex flex-wrap gap-4 align-items-start">
			<div class="profile-logo"><img src="~/img/brand/atnodus-icon.svg" alt="" /></div>
			<div class="flex-grow-1">
				<div class="d-flex flex-wrap align-items-center gap-2 mb-1">
					<h1 class="h2 fw-bold mb-0">@orgTitle</h1>
					<span class="badge text-bg-info">Matriz</span>
					@if (!string.IsNullOrWhiteSpace(org.Segment))
					{
						<span class="badge text-bg-secondary">@org.Segment</span>
					}
				</div>
				<p class="text-secondary mb-2">@(string.IsNullOrWhiteSpace(org.Description) ? "Empresa no ecossistema atNodus." : org.Description)</p>
				<div class="d-flex flex-wrap gap-3 small text-secondary">
					<span>Código <strong class="text-body">@org.Code</strong></span>
					@if (!string.IsNullOrWhiteSpace(org.TaxId))
					{
						<span>CNPJ <strong class="text-body">@org.TaxId</strong></span>
					}
					<span>Filiais <strong class="text-body">@Model.BranchCount</strong></span>
					@if (!string.IsNullOrWhiteSpace(orgAddress))
					{
						<span>@orgAddress</span>
					}
				</div>
			</div>
			<div class="d-flex flex-wrap gap-2 ms-lg-auto">
				<a class="btn btn-outline-secondary" href="/Admin/Organizations">Voltar</a>
			</div>
		</div>
	</div>
}
