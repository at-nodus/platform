@using SSO.Middleware.Identity
@inject IAdminPortalContextService Portal
@{
	var display = User.Identity?.Name ?? "Usuário";
	var initials = string.Concat(display.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpperInvariant(p[0])));
	if (string.IsNullOrEmpty(initials)) { initials = "U"; }
	var page = (ViewContext.RouteData.Values["page"]?.ToString() ?? string.Empty).TrimEnd('/');
	var path = Context.Request.Path.Value ?? string.Empty;
	bool IsPage(string name) =>
		page.Equals("/" + name, StringComparison.OrdinalIgnoreCase)
		|| page.EndsWith("/" + name, StringComparison.OrdinalIgnoreCase)
		|| path.Contains("/Admin/" + name, StringComparison.OrdinalIgnoreCase);
	var isHome = page.Equals("/Index", StringComparison.OrdinalIgnoreCase)
		|| path.TrimEnd('/').Equals("/Admin", StringComparison.OrdinalIgnoreCase);
	var isOrganizations = IsPage("Organizations") || path.Contains("/Organizations/", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>@ViewData["Title"] — atNodus Admin</title>
	<partial name="_BrandHead" />
</head>
<body>
	<div class="app-shell d-flex">
		<aside class="app-sidebar d-none d-lg-flex flex-column p-3 sticky-top vh-100 overflow-auto">
			<a class="app-sidebar-brand d-flex align-items-center mb-4 px-2" asp-area="Admin" asp-page="/Index">
				<img src="~/img/brand/atnodus-logo-dark.svg" alt="atNodus" />
			</a>
			<p class="text-uppercase text-secondary small fw-medium px-2 mb-2" style="letter-spacing: 0.06em; font-size: 0.7rem">Admin</p>
			<nav class="nav nav-pills flex-column gap-1 mb-auto">
				<a class="nav-link @(isHome ? "active" : null)" asp-area="Admin" asp-page="/Index" aria-current="@(isHome ? "page" : null)"><i class="fa-solid fa-house fa-fw" aria-hidden="true"></i>Início</a>
				<a class="nav-link @(IsPage("SwitchContext") ? "active" : null)" asp-area="Admin" asp-page="/SwitchContext"><i class="fa-solid fa-building fa-fw" aria-hidden="true"></i>Contexto</a>
				@if (Portal.HasPermission(SSO.Shared.Identity.SsoAdminPermissions.Org) || Portal.IsPlatformAdmin)
				{
					<a class="nav-link @(IsPage("Branches") ? "active" : null)" asp-area="Admin" asp-page="/Branches"><i class="fa-solid fa-code-branch fa-fw" aria-hidden="true"></i>Filiais</a>
					<a class="nav-link @(IsPage("Invites") ? "active" : null)" asp-area="Admin" asp-page="/Invites"><i class="fa-solid fa-envelope fa-fw" aria-hidden="true"></i>Convites</a>
					<a class="nav-link @(IsPage("Memberships") ? "active" : null)" asp-area="Admin" asp-page="/Memberships"><i class="fa-solid fa-users fa-fw" aria-hidden="true"></i>Memberships</a>
					<a class="nav-link @(IsPage("UserRoleAssignments") ? "active" : null)" asp-area="Admin" asp-page="/UserRoleAssignments"><i class="fa-solid fa-user-shield fa-fw" aria-hidden="true"></i>Atribuições</a>
					<a class="nav-link @(IsPage("UserClaimAssignments") ? "active" : null)" asp-area="Admin" asp-page="/UserClaimAssignments"><i class="fa-solid fa-id-badge fa-fw" aria-hidden="true"></i>Claims de usuário</a>
					<a class="nav-link @(IsPage("ProductEnablements") ? "active" : null)" asp-area="Admin" asp-page="/ProductEnablements"><i class="fa-solid fa-toggle-on fa-fw" aria-hidden="true"></i>Habilitações</a>
				}
				@if (Portal.HasPermission(SSO.Shared.Identity.SsoAdminPermissions.SessionsRevoke))
				{
					<a class="nav-link @(IsPage("Sessions") ? "active" : null)" asp-area="Admin" asp-page="/Sessions">Sessões</a>
				}
				@if (Portal.IsPlatformAdmin)
				{
					<a class="nav-link @(isOrganizations ? "active" : null)" asp-area="Admin" asp-page="/Organizations" aria-current="@(isOrganizations ? "page" : null)">Organizações</a>
					<a class="nav-link @(IsPage("Products") && !IsPage("ProductEnablements") && !IsPage("ClientProductBindings") ? "active" : null)" asp-area="Admin" asp-page="/Products">Produtos</a>
					<a class="nav-link @(IsPage("Permissions") && !IsPage("RolePermissions") ? "active" : null)" asp-area="Admin" asp-page="/Permissions">Permissões</a>
					<a class="nav-link @(page.Equals("/Roles", StringComparison.OrdinalIgnoreCase) ? "active" : null)" asp-area="Admin" asp-page="/Roles">Roles</a>
					<a class="nav-link @(IsPage("RolePermissions") ? "active" : null)" asp-area="Admin" asp-page="/RolePermissions">Permissões por role</a>
					<a class="nav-link @(IsPage("ClientProductBindings") ? "active" : null)" asp-area="Admin" asp-page="/ClientProductBindings">Bindings</a>
					<a class="nav-link @(IsPage("AuthClients") ? "active" : null)" asp-area="Admin" asp-page="/AuthClients">Auth Clients</a>
					<a class="nav-link @(IsPage("ExternalIdPs") ? "active" : null)" asp-area="Admin" asp-page="/ExternalIdPs">Provedores externos</a>
					<a class="nav-link @(IsPage("ClaimDefinitions") ? "active" : null)" asp-area="Admin" asp-page="/ClaimDefinitions">Definições de claim</a>
					<a class="nav-link @(IsPage("RoleClaims") ? "active" : null)" asp-area="Admin" asp-page="/RoleClaims">Claims por role</a>
					<a class="nav-link @(IsPage("Users") ? "active" : null)" asp-area="Admin" asp-page="/Users">Usuários</a>
					<a class="nav-link @(IsPage("LdapMaps") ? "active" : null)" asp-area="Admin" asp-page="/LdapMaps">Mapeamentos LDAP</a>
				}
				@if (Portal.IsPlatformAdmin || Portal.HasPermission(SSO.Shared.Identity.SsoAdminPermissions.Menus))
				{
					<a class="nav-link @(IsPage("MenuItems") ? "active" : null)" asp-area="Admin" asp-page="/MenuItems">Itens de menu</a>
				}
				@if (Portal.HasPermission(SSO.Shared.Identity.SsoAdminPermissions.AuditRead))
				{
					<a class="nav-link @(IsPage("Audit") ? "active" : null)" asp-area="Admin" asp-page="/Audit">Auditoria</a>
				}
			</nav>
			<p class="text-uppercase text-secondary small fw-medium px-2 mb-2 mt-4" style="letter-spacing: 0.06em; font-size: 0.7rem">Conta</p>
			<nav class="nav nav-pills flex-column gap-1">
				<a class="nav-link" asp-area="Me" asp-page="/Profile"><i class="fa-solid fa-user fa-fw" aria-hidden="true"></i>Meu perfil</a>
				<a class="nav-link" href="/Account/Logout"><i class="fa-solid fa-arrow-right-from-bracket fa-fw" aria-hidden="true"></i>Sair</a>
			</nav>
		</aside>

		<div class="app-main flex-grow-1 d-flex flex-column min-vh-100">
			<header class="app-topbar d-flex align-items-center gap-3 px-3 px-lg-4">
				<button class="btn btn-outline-secondary btn-icon d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#adminMobileNav" aria-label="Menu">
					<i class="fa-solid fa-bars" aria-hidden="true"></i>
				</button>
				<form class="flex-grow-1" style="max-width: 22rem" role="search" method="get" asp-area="Admin" asp-page="/Organizations">
					<input class="form-control form-control-sm bg-body-tertiary" type="search" name="q" placeholder="Buscar organizações…" aria-label="Buscar" />
				</form>
				<a class="avatar ms-auto" asp-area="Me" asp-page="/Profile" title="@display">@initials</a>
			</header>
			<main class="flex-grow-1">
				<div class="container-fluid px-3 px-lg-4 py-3 py-lg-4 admin-content">
					@RenderBody()
				</div>
			</main>
		</div>
	</div>

	<div class="offcanvas offcanvas-start app-nav-offcanvas" tabindex="-1" id="adminMobileNav">
		<div class="offcanvas-header">
			<img src="~/img/brand/atnodus-logo-dark.svg" alt="atNodus" style="height:1.75rem" />
			<button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Fechar"></button>
		</div>
		<div class="offcanvas-body">
			<nav class="nav nav-pills flex-column gap-1">
				<a class="nav-link" asp-area="Admin" asp-page="/Index">Início</a>
				<a class="nav-link" asp-area="Admin" asp-page="/SwitchContext">Contexto</a>
				@if (Portal.HasPermission(SSO.Shared.Identity.SsoAdminPermissions.Org) || Portal.IsPlatformAdmin)
				{
					<a class="nav-link" asp-area="Admin" asp-page="/Branches">Filiais</a>
					<a class="nav-link" asp-area="Admin" asp-page="/Invites">Convites</a>
					<a class="nav-link" asp-area="Admin" asp-page="/Memberships">Memberships</a>
				}
				@if (Portal.IsPlatformAdmin)
				{
					<a class="nav-link" asp-area="Admin" asp-page="/Organizations">Organizações</a>
					<a class="nav-link" asp-area="Admin" asp-page="/Products">Produtos</a>
					<a class="nav-link" asp-area="Admin" asp-page="/Users">Usuários</a>
				}
				<a class="nav-link" asp-area="Me" asp-page="/Profile">Meu perfil</a>
				<a class="nav-link" href="/Account/Logout">Sair</a>
			</nav>
		</div>
	</div>

	<partial name="_BrandScripts" />
</body>
</html>
