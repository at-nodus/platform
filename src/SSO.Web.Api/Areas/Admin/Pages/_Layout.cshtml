@using SSO.Middleware.Identity
@inject IAdminPortalContextService Portal
@{
	var display = User.Identity?.Name ?? "Usuário";
	var initials = string.Concat(display.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpperInvariant(p[0])));
	if (string.IsNullOrEmpty(initials)) { initials = "U"; }
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>@ViewData["Title"] — atNodus Admin</title>
	<partial name="_BrandHead" />
</head>
<body>
	<div class="app-shell d-flex">
		<aside class="app-sidebar d-none d-lg-flex flex-column p-3 sticky-top vh-100 overflow-auto">
			<a class="app-sidebar-brand d-flex align-items-center mb-4 px-2" asp-area="Admin" asp-page="/Index">
				<img src="~/img/brand/atnodus-logo-dark.svg" alt="atNodus" />
			</a>
			<p class="text-uppercase text-secondary small fw-medium px-2 mb-2" style="letter-spacing: 0.06em; font-size: 0.7rem">Admin</p>
			<nav class="nav nav-pills flex-column gap-1 mb-auto">
				<partial name="~/Areas/Admin/Pages/Shared/_AdminNav.cshtml" />
			</nav>
			<p class="text-uppercase text-secondary small fw-medium px-2 mb-2 mt-4" style="letter-spacing: 0.06em; font-size: 0.7rem">Conta</p>
			<nav class="nav nav-pills flex-column gap-1">
				<a class="nav-link" asp-area="Me" asp-page="/Profile"><i class="fa-solid fa-user fa-fw" aria-hidden="true"></i>Meu perfil</a>
				<a class="nav-link" href="/Account/Logout"><i class="fa-solid fa-arrow-right-from-bracket fa-fw" aria-hidden="true"></i>Sair</a>
			</nav>
		</aside>

		<div class="app-main flex-grow-1 d-flex flex-column min-vh-100">
			<header class="app-topbar d-flex align-items-center gap-3 px-3 px-lg-4">
				<button class="btn btn-outline-secondary btn-icon d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#adminMobileNav" aria-label="Menu">
					<i class="fa-solid fa-bars" aria-hidden="true"></i>
				</button>
				<form class="flex-grow-1" style="max-width: 22rem" role="search" method="get" asp-area="Admin" asp-page="/Organizations">
					<input class="form-control form-control-sm bg-body-tertiary" type="search" name="q" placeholder="Buscar organizações…" aria-label="Buscar" />
				</form>
				<a class="avatar ms-auto" asp-area="Me" asp-page="/Profile" title="@display">@initials</a>
			</header>
			<main class="flex-grow-1">
				<div class="container-fluid px-3 px-lg-4 py-3 py-lg-4 admin-content">
					@RenderBody()
				</div>
			</main>
		</div>
	</div>

	<div class="offcanvas offcanvas-start app-nav-offcanvas" tabindex="-1" id="adminMobileNav">
		<div class="offcanvas-header">
			<img src="~/img/brand/atnodus-logo-dark.svg" alt="atNodus" style="height:1.75rem" />
			<button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Fechar"></button>
		</div>
		<div class="offcanvas-body">
			<nav class="nav nav-pills flex-column gap-1">
				<partial name="~/Areas/Admin/Pages/Shared/_AdminNav.cshtml" />
				<a class="nav-link" asp-area="Me" asp-page="/Profile">Meu perfil</a>
				<a class="nav-link" href="/Account/Logout">Sair</a>
			</nav>
		</div>
	</div>

	<partial name="_BrandScripts" />
</body>
</html>
