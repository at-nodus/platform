@page "{clientId}"
@using System.Linq
@model SSO.Web.Api.Areas.Admin.Pages.AuthClients.DetailsModel
@{
	ViewData["Title"] = Model.ClientId;
	bool Is(string key) => string.Equals(Model.ActiveTab, key, StringComparison.Ordinal);
}
<nav aria-label="breadcrumb" class="mb-3">
	<ol class="breadcrumb mb-0">
		<li class="breadcrumb-item"><a asp-area="Admin" asp-page="/AuthClients">Auth Clients</a></li>
		<li class="breadcrumb-item active">@Model.ClientId</li>
	</ol>
</nav>
@if (!string.IsNullOrEmpty(Model.Message)) { <div class="alert alert-success">@Model.Message</div> }
@if (!string.IsNullOrEmpty(Model.Error)) { <div class="alert alert-danger">@Model.Error</div> }
@if (Model.Metadata is null)
{
	<p class="text-secondary">Client não encontrado.</p>
}
else
{
	<div class="card border shadow-sm mb-3">
		<div class="card-body d-flex flex-wrap justify-content-between gap-3">
			<div>
				<h1 class="h2 fw-bold mb-1">@Model.Metadata.DisplayName</h1>
				<p class="text-secondary mb-0"><code>@Model.Metadata.ClientId</code> · consentimento @Model.Metadata.RequireConsent</p>
			</div>
			@if (Model.Metadata.IsEnabled)
			{
				<form method="post" asp-page-handler="Disable">
					<button class="btn btn-outline-secondary" type="submit">Desabilitar</button>
				</form>
			}
			else
			{
				<span class="badge text-bg-secondary align-self-center">Desabilitado</span>
			}
		</div>
	</div>
	<div class="card border shadow-sm">
		<div class="card-header px-0 pb-0 border-bottom-0">
			<ul class="nav nav-tabs px-3">
				<li class="nav-item"><a class="nav-link @(Is("dados") ? "active" : null)" href="@SSO.Web.Api.Areas.Admin.AdminHubUrls.AuthClientDetails(Model.ClientId)">Dados</a></li>
				<li class="nav-item"><a class="nav-link @(Is("bindings") ? "active" : null)" href="@SSO.Web.Api.Areas.Admin.AdminHubUrls.AuthClientDetails(Model.ClientId, "bindings")">Produtos</a></li>
			</ul>
		</div>
		<div class="card-body">
			@if (Is("dados"))
			{
				<dl class="row mb-0">
					<dt class="col-sm-3 text-secondary small">Client Id</dt><dd class="col-sm-9"><code>@Model.Metadata.ClientId</code></dd>
					<dt class="col-sm-3 text-secondary small">First party</dt><dd class="col-sm-9">@(Model.Metadata.IsFirstParty ? "Sim" : "Não")</dd>
					<dt class="col-sm-3 text-secondary small">Habilitado</dt><dd class="col-sm-9">@(Model.Metadata.IsEnabled ? "Sim" : "Não")</dd>
				</dl>
			}
			else if (Is("bindings"))
			{
				<form method="post" asp-page-handler="AddBinding" class="row g-2 mb-4" style="max-width: 32rem">
					<input type="hidden" name="tab" value="bindings" />
					<div class="col-md-8">
						<select class="form-select" asp-for="ProductId">
							@foreach (var p in Model.AvailableProducts)
							{
								<option value="@p.Id">@p.Name</option>
							}
						</select>
					</div>
					<div class="col-md-4"><button class="btn btn-primary" type="submit">Vincular</button></div>
				</form>
				<table class="table table-hover mb-0">
					<thead><tr><th>Produto</th><th></th></tr></thead>
					<tbody>
					@foreach (var b in Model.Bindings)
					{
						var product = Model.AllProducts.FirstOrDefault(x => x.Id == b.ProductId);
						<tr>
							<td>@(product?.Name ?? b.ProductId.ToString())</td>
							<td>
								<form method="post" asp-page-handler="RemoveBinding" class="d-inline">
									<input type="hidden" name="tab" value="bindings" />
									<input type="hidden" name="bindingId" value="@b.Id" />
									<button class="btn btn-outline-secondary btn-sm" type="submit">Remover</button>
								</form>
							</td>
						</tr>
					}
					</tbody>
				</table>
			}
		</div>
	</div>
}
