@page
@model SSO.Web.Api.Areas.Admin.Pages.ProductsModel
@{
	ViewData["Title"] = "Produtos";
}
<h1>Produtos</h1>
@if (!string.IsNullOrEmpty(Model.Message)) { <div class="flash">@Model.Message</div> }
@if (!string.IsNullOrEmpty(Model.Error)) { <div class="flash error">@Model.Error</div> }

@if (Model.EditId is Guid editId)
{
	<div class="card">
		<h2>Editar produto</h2>
		<form method="post" asp-page-handler="Update">
			<input type="hidden" name="id" value="@editId" />
			<label>Nome</label>
			<input asp-for="Name" required />
			<label>Código</label>
			<input asp-for="Code" required />
			<div class="d-flex justify-content-end gap-2 mt-2 pt-3 border-top">
				<a class="btn btn-outline-secondary" asp-page="Products">Cancelar</a>
				<button class="btn btn-primary" type="submit">Salvar alterações</button>
			</div>
		</form>
	</div>
}
else
{
	<div class="card">
		<h2>Novo produto</h2>
		<form method="post">
			<label>Nome</label>
			<input asp-for="Name" required />
			<label>Código</label>
			<input asp-for="Code" required />
			<div class="d-flex justify-content-end gap-2 mt-2 pt-3 border-top">
				<button class="btn btn-primary" type="submit">Criar</button>
			</div>
		</form>
	</div>
}

<div class="card">
	<table>
		<thead><tr><th>Nome</th><th>Código</th><th>Id</th><th></th></tr></thead>
		<tbody>
		@foreach (var p in Model.Items)
		{
			<tr>
				<td>@p.Name</td>
				<td>@p.Code</td>
				<td><code>@p.Id</code></td>
				<td>
					<div class="d-flex gap-2 align-items-center">
						<a asp-page="Products" asp-route-EditId="@p.Id">Editar</a>
						<form method="post" asp-page-handler="Delete">
							<input type="hidden" name="id" value="@p.Id" />
							<button class="btn btn-outline-secondary btn-sm" type="submit">Excluir</button>
						</form>
					</div>
				</td>
			</tr>
		}
		</tbody>
	</table>
</div>
