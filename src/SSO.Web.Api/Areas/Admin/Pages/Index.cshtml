@page
@model SSO.Web.Api.Areas.Admin.Pages.IndexModel
@{
	ViewData["Title"] = "Início";
	var canOrg = Model.Portal.IsPlatformAdmin || Model.Portal.HasPermission(SSO.Shared.Identity.SsoAdminPermissions.Org);
}
<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
	<div>
		<p class="text-uppercase text-secondary small fw-medium mb-1" style="letter-spacing: 0.06em">Admin</p>
		<h1 class="h2 fw-bold mb-1">Portal administrativo</h1>
		<p class="text-secondary mb-0">
			Org ativa: <strong>@(Model.Portal.OrganizationId?.ToString("D") ?? "(nenhuma)")</strong>
			· Branch: <strong>@(Model.Portal.BranchId?.ToString("D") ?? "(nenhuma)")</strong>
		</p>
	</div>
	<a class="btn btn-outline-secondary" asp-area="Admin" asp-page="/SwitchContext">Trocar contexto</a>
</div>

<div class="row g-3 mb-4">
	@if (Model.Portal.IsPlatformAdmin)
	{
		<div class="col-md-6 col-xl-3">
			<a class="card border shadow-sm h-100 text-decoration-none" asp-area="Admin" asp-page="/Organizations">
				<div class="card-body">
					<div class="text-secondary small mb-1">Cadastros</div>
					<div class="fw-bold text-body">Organizações</div>
					<div class="small text-secondary mt-1">Empresas e detalhes</div>
				</div>
			</a>
		</div>
	}
	@if (canOrg)
	{
		<div class="col-md-6 col-xl-3">
			<a class="card border shadow-sm h-100 text-decoration-none" asp-area="Admin" asp-page="/Branches">
				<div class="card-body">
					<div class="text-secondary small mb-1">Cadastros</div>
					<div class="fw-bold text-body">Filiais</div>
					<div class="small text-secondary mt-1">Rede de branches</div>
				</div>
			</a>
		</div>
		<div class="col-md-6 col-xl-3">
			<a class="card border shadow-sm h-100 text-decoration-none" asp-area="Admin" asp-page="/Invites">
				<div class="card-body">
					<div class="text-secondary small mb-1">Acesso</div>
					<div class="fw-bold text-body">Convites</div>
					<div class="small text-secondary mt-1">Vincular usuários</div>
				</div>
			</a>
		</div>
	}
	@if (Model.Portal.IsPlatformAdmin)
	{
		<div class="col-md-6 col-xl-3">
			<a class="card border shadow-sm h-100 text-decoration-none" asp-area="Admin" asp-page="/Users">
				<div class="card-body">
					<div class="text-secondary small mb-1">Identidade</div>
					<div class="fw-bold text-body">Usuários</div>
					<div class="small text-secondary mt-1">Contas da plataforma</div>
				</div>
			</a>
		</div>
	}
</div>

<div class="card border shadow-sm">
	<div class="card-header">
		<h2 class="h5 fw-bold mb-0">Permissões no contexto</h2>
	</div>
	<div class="card-body">
		<p class="small text-secondary mb-3">Use <strong>Contexto</strong> para definir organização/filial. Convites são obrigatórios para vincular usuários.</p>
		@if (Model.Portal.Permissions.Count == 0)
		{
			<p class="text-secondary mb-0">Nenhuma permissão administrativa no contexto atual.</p>
		}
		else
		{
			<div class="d-flex flex-wrap gap-2">
				@foreach (var p in Model.Portal.Permissions.OrderBy(x => x))
				{
					<span class="badge text-bg-light border"><code>@p</code></span>
				}
			</div>
		}
	</div>
</div>
