@page
@model SSO.Web.Api.Areas.Me.Pages.IndexModel
@{
	ViewData["Title"] = "Painel";
}
<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
	<div>
		<p class="text-uppercase text-secondary small fw-medium mb-1" style="letter-spacing: 0.06em">Visão geral</p>
		<h1 class="h2 fw-bold mb-1">Olá, @Model.DisplayName</h1>
		<p class="text-secondary mb-0">Seus vínculos, acessos e atalhos no ecossistema atNodus.</p>
	</div>
	<a class="btn btn-primary" asp-area="Me" asp-page="/Organizations/Index">Ver empresas</a>
</div>

<div class="row g-3 mb-3">
	<div class="col-6 col-xl-3">
		<div class="card h-100 border shadow-sm">
			<div class="card-body">
				<div class="d-flex justify-content-between align-items-center mb-2">
					<span class="text-secondary small fw-medium">Empresas</span>
					<span class="icon-tile" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 20V8l8-4 8 4v12" /><path d="M9 20v-6h6v6" /></svg></span>
				</div>
				<div class="stat-value">@Model.OrganizationCount</div>
				<span class="badge badge-soft-neutral mt-2">vínculos ativos</span>
			</div>
		</div>
	</div>
	<div class="col-6 col-xl-3">
		<div class="card h-100 border shadow-sm">
			<div class="card-body">
				<div class="d-flex justify-content-between align-items-center mb-2">
					<span class="text-secondary small fw-medium">Produtos</span>
					<span class="icon-tile accent" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="4" y="4" width="7" height="7" rx="1.5" /><rect x="13" y="4" width="7" height="7" rx="1.5" /><rect x="4" y="13" width="7" height="7" rx="1.5" /><rect x="13" y="13" width="7" height="7" rx="1.5" /></svg></span>
				</div>
				<div class="stat-value">@Model.ProductCount</div>
				<span class="badge badge-soft-neutral mt-2">com acesso</span>
			</div>
		</div>
	</div>
	<div class="col-6 col-xl-3">
		<div class="card h-100 border shadow-sm">
			<div class="card-body">
				<div class="d-flex justify-content-between align-items-center mb-2">
					<span class="text-secondary small fw-medium">Perfis</span>
					<span class="icon-tile info" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="3.5" /><path d="M5 19c1.8-3.2 4.2-4.8 7-4.8s5.2 1.6 7 4.8" /></svg></span>
				</div>
				<div class="stat-value">@Model.RoleCount</div>
				<span class="badge badge-soft-neutral mt-2">roles atribuídas</span>
			</div>
		</div>
	</div>
	<div class="col-6 col-xl-3">
		<div class="card h-100 border shadow-sm">
			<div class="card-body">
				<div class="d-flex justify-content-between align-items-center mb-2">
					<span class="text-secondary small fw-medium">Convites</span>
					<span class="icon-tile success" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 6h16v12H4z" /><path d="m4 7 8 6 8-6" /></svg></span>
				</div>
				<div class="stat-value">@Model.PendingInviteCount</div>
				<span class="badge @(Model.PendingInviteCount > 0 ? "badge-soft-warning" : "badge-soft-success") mt-2">pendentes</span>
			</div>
		</div>
	</div>
</div>

<div class="row g-3">
	<div class="col-lg-5">
		<div class="card border shadow-sm h-100">
			<div class="card-header"><h2 class="h5 fw-bold mb-0">Atalhos</h2></div>
			<div class="card-body">
				<div class="list-group list-group-flush">
					<a class="list-group-item list-group-item-action d-flex gap-3 px-0" asp-area="Me" asp-page="/Organizations/Index">
						<span class="entity-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 20V8l8-4 8 4v12" /><path d="M9 20v-6h6v6" /></svg></span>
						<span><strong class="d-block">Ver empresas</strong><span class="small text-secondary">Consultar vínculos e branches</span></span>
					</a>
					<a class="list-group-item list-group-item-action d-flex gap-3 px-0" asp-area="Me" asp-page="/Profile" asp-fragment="acessos">
						<span class="entity-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="4" y="4" width="7" height="7" rx="1.5" /><rect x="13" y="4" width="7" height="7" rx="1.5" /><rect x="4" y="13" width="7" height="7" rx="1.5" /><rect x="13" y="13" width="7" height="7" rx="1.5" /></svg></span>
						<span><strong class="d-block">Meus acessos</strong><span class="small text-secondary">Produtos e perfis associados</span></span>
					</a>
					<a class="list-group-item list-group-item-action d-flex gap-3 px-0" asp-area="Me" asp-page="/Profile" asp-fragment="convites">
						<span class="entity-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 6h16v12H4z" /><path d="m4 7 8 6 8-6" /></svg></span>
						<span><strong class="d-block">Convites</strong><span class="small text-secondary">Aceitar ou recusar vínculos</span></span>
					</a>
				</div>
			</div>
		</div>
	</div>
	<div class="col-lg-7">
		<div class="card border shadow-sm h-100">
			<div class="card-header d-flex justify-content-between align-items-center">
				<div>
					<h2 class="h5 fw-bold mb-0">Sua conta</h2>
					<p class="small text-secondary mb-0">Resumo do acesso atual</p>
				</div>
				<a class="btn btn-link btn-sm" asp-area="Me" asp-page="/Profile">Abrir perfil</a>
			</div>
			<div class="card-body d-flex align-items-center justify-content-center text-center py-5">
				<div>
					<div class="profile-logo mx-auto mb-3"><img src="~/img/brand/atnodus-icon.svg" alt="" /></div>
					<h3 class="h6 fw-bold mb-1">@Model.DisplayName</h3>
					<p class="small text-secondary mb-0">@Model.OrganizationCount empresas · @Model.ProductCount produtos · @Model.RoleCount perfis</p>
				</div>
			</div>
		</div>
	</div>
</div>
