@page "{id:guid}"
@model SSO.Web.Api.Areas.Me.Pages.Organizations.DetailsModel
@{
	Layout = Model.IsAdminRoute ? "~/Areas/Admin/Pages/_Layout.cshtml" : "_Layout";
	ViewData["Title"] = Model.Organization?.TradeName ?? Model.Organization?.Name ?? "Empresa";
	var backArea = Model.IsAdminRoute ? "Admin" : "Me";
	var backPage = Model.IsAdminRoute ? "/Organizations" : "/Organizations/Index";
	var org = Model.Organization;
	var orgTitle = !string.IsNullOrWhiteSpace(org?.TradeName) ? org!.TradeName : org?.Name;
	var orgAddress = org is null ? "" : PartyAddressFormatting.FormatAddress(org.PostalCode, org.Street, org.Number, org.Complement, org.City, org.State);
	var activeTab = Model.BranchEditId.HasValue ? "branches"
		: Model.ContactEditId.HasValue ? "contato"
		: string.IsNullOrWhiteSpace(Model.ActiveTab) ? "dados" : Model.ActiveTab;
	bool IsTab(string id) => string.Equals(activeTab, id, StringComparison.Ordinal);
}
@if (!string.IsNullOrWhiteSpace(Model.Message))
{
	<div class="alert alert-success">@Model.Message</div>
}
@if (!string.IsNullOrWhiteSpace(Model.Error))
{
	<div class="alert alert-danger">@Model.Error</div>
}
@if (Model.Organization is null)
{
	<p class="text-secondary">Empresa não encontrada.</p>
}
else
{
<nav aria-label="breadcrumb" class="mb-3">
	<ol class="breadcrumb mb-0">
		<li class="breadcrumb-item"><a asp-area="@backArea" asp-page="@backPage">Empresas</a></li>
		<li class="breadcrumb-item active" aria-current="page">@orgTitle</li>
	</ol>
</nav>

<div class="card border shadow-sm mb-3">
	<div class="card-body d-flex flex-wrap gap-4 align-items-start">
		<div class="profile-logo"><img src="~/img/brand/atnodus-icon.svg" alt="" /></div>
		<div class="flex-grow-1">
			<div class="d-flex flex-wrap align-items-center gap-2 mb-1">
				<h1 class="h2 fw-bold mb-0">@orgTitle</h1>
				<span class="badge text-bg-info">Matriz</span>
				@if (!string.IsNullOrWhiteSpace(Model.Organization.Segment))
				{
					<span class="badge text-bg-secondary">@Model.Organization.Segment</span>
				}
			</div>
			<p class="text-secondary mb-2">@(string.IsNullOrWhiteSpace(Model.Organization.Description) ? "Empresa com rede de branches (unidades/filiais) no ecossistema atNodus." : Model.Organization.Description)</p>
			<div class="d-flex flex-wrap gap-3 small text-secondary">
				<span>Código <strong class="text-body">@Model.Organization.Code</strong></span>
				@if (!string.IsNullOrWhiteSpace(Model.Organization.TaxId))
				{
					<span>CNPJ <strong class="text-body">@Model.Organization.TaxId</strong></span>
				}
				<span>Filiais <strong class="text-body">@Model.Branches.Count</strong></span>
				<span>Produtos <strong class="text-body">@Model.Products.Count</strong></span>
				<span>Usuários <strong class="text-body">@Model.Members.Count</strong></span>
				<span>Atualizado <strong class="text-body">@((Model.Organization.UpdatedAt ?? Model.Organization.CreatedAt).ToLocalTime().ToString("dd/MM/yyyy"))</strong></span>
			</div>
		</div>
		<div class="d-flex flex-wrap gap-2 ms-lg-auto">
			<a class="btn btn-outline-secondary" asp-area="@backArea" asp-page="@backPage">Voltar</a>
			@if (Model.CanEditOrg)
			{
				<button class="btn btn-outline-secondary" type="button" id="btnEditOrganization">Editar empresa</button>
			}
			@if (Model.CanManageBranches)
			{
				<button class="btn btn-primary" type="button" id="btnNewBranch">Nova branch</button>
			}
		</div>
	</div>
</div>

<div class="card border shadow-sm">
	<div class="card-header px-0 pb-0 border-bottom-0">
		<ul class="nav nav-tabs px-3" id="companyTabs" role="tablist">
			<li class="nav-item" role="presentation">
				<button class="nav-link @(IsTab("dados") ? "active" : null)" id="tab-dados" data-bs-toggle="tab" data-bs-target="#dados" type="button" role="tab" aria-controls="dados" aria-selected="@(IsTab("dados") ? "true" : "false")">Dados</button>
			</li>
			<li class="nav-item" role="presentation">
				<button class="nav-link @(IsTab("branches") ? "active" : null)" id="tab-branches" data-bs-toggle="tab" data-bs-target="#branches" type="button" role="tab" aria-controls="branches" aria-selected="@(IsTab("branches") ? "true" : "false")">Branches</button>
			</li>
			<li class="nav-item" role="presentation">
				<button class="nav-link @(IsTab("contato") ? "active" : null)" id="tab-contato" data-bs-toggle="tab" data-bs-target="#contato" type="button" role="tab" aria-controls="contato" aria-selected="@(IsTab("contato") ? "true" : "false")">Contatos</button>
			</li>
			<li class="nav-item" role="presentation">
				<button class="nav-link @(IsTab("produtos") ? "active" : null)" id="tab-produtos" data-bs-toggle="tab" data-bs-target="#produtos" type="button" role="tab" aria-controls="produtos" aria-selected="@(IsTab("produtos") ? "true" : "false")">Produtos</button>
			</li>
			<li class="nav-item" role="presentation">
				<button class="nav-link @(IsTab("usuarios") ? "active" : null)" id="tab-usuarios" data-bs-toggle="tab" data-bs-target="#usuarios" type="button" role="tab" aria-controls="usuarios" aria-selected="@(IsTab("usuarios") ? "true" : "false")">Usuários</button>
			</li>
		</ul>
	</div>
	<div class="card-body tab-content" id="companyTabsContent">
		<div class="tab-pane fade @(IsTab("dados") ? "show active" : null)" id="dados" role="tabpanel" aria-labelledby="tab-dados" tabindex="0">
			<h2 class="h6 text-secondary text-uppercase mb-3" style="letter-spacing: 0.04em">Identificação da empresa</h2>
			<dl class="row mb-0">
				<dt class="col-sm-3 text-secondary small">Razão social</dt><dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Organization.LegalName) ? "—" : Model.Organization.LegalName)</dd>
				<dt class="col-sm-3 text-secondary small">Nome fantasia</dt><dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Organization.TradeName) ? "—" : Model.Organization.TradeName)</dd>
				<dt class="col-sm-3 text-secondary small">CNPJ (raiz)</dt><dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Organization.TaxId) ? "—" : Model.Organization.TaxId)</dd>
				<dt class="col-sm-3 text-secondary small">Segmento</dt><dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Organization.Segment) ? "—" : Model.Organization.Segment)</dd>
				<dt class="col-sm-3 text-secondary small">Tipo na rede</dt><dd class="col-sm-9"><span class="badge text-bg-info">Matriz</span></dd>
				<dt class="col-sm-3 text-secondary small">Código</dt><dd class="col-sm-9">@Model.Organization.Code</dd>
				<dt class="col-sm-3 text-secondary small">Nome (exibição)</dt><dd class="col-sm-9">@Model.Organization.Name</dd>
				<dt class="col-sm-3 text-secondary small">Descrição</dt><dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Organization.Description) ? "—" : Model.Organization.Description)</dd>
				<dt class="col-sm-3 text-secondary small">Endereço</dt><dd class="col-sm-9">@(string.IsNullOrWhiteSpace(orgAddress) ? "—" : orgAddress)</dd>
				<dt class="col-sm-3 text-secondary small">Herança de autorização</dt><dd class="col-sm-9">@Model.Organization.BranchAuthzInheritance</dd>
			</dl>
			@if (Model.CanEditOrg)
			{
				<div class="collapse mt-4" id="organizationEdit">
					<div class="card border bg-body-tertiary">
						<div class="card-body">
							<form method="post" asp-page-handler="UpdateOrg" class="row g-3">
								<input type="hidden" asp-for="Id" />
								<div class="col-md-6"><label class="form-label" asp-for="OrgName">Nome (exibição)</label><input class="form-control" asp-for="OrgName" required /></div>
								<div class="col-md-6"><label class="form-label" asp-for="OrgCode">Código</label><input class="form-control" asp-for="OrgCode" required /></div>
								<div class="col-md-6"><label class="form-label" asp-for="OrgLegalName">Razão social</label><input class="form-control" asp-for="OrgLegalName" /></div>
								<div class="col-md-6"><label class="form-label" asp-for="OrgTradeName">Nome fantasia</label><input class="form-control" asp-for="OrgTradeName" /></div>
								<div class="col-md-6"><label class="form-label" asp-for="OrgTaxId">CNPJ</label><input class="form-control" asp-for="OrgTaxId" placeholder="00.000.000/0000-00" /></div>
								<div class="col-md-6"><label class="form-label" asp-for="OrgSegment">Segmento</label><input class="form-control" asp-for="OrgSegment" list="org-segments" /></div>
								<div class="col-12"><label class="form-label" asp-for="OrgDescription">Descrição</label><textarea class="form-control" asp-for="OrgDescription" rows="3"></textarea></div>
								<div class="col-12"><h3 class="h6 fw-bold mb-0">Endereço</h3></div>
								<div class="col-md-4"><label class="form-label" asp-for="OrgPostalCode">CEP</label><input class="form-control" asp-for="OrgPostalCode" /></div>
								<div class="col-md-8"><label class="form-label" asp-for="OrgCity">Cidade</label><input class="form-control" asp-for="OrgCity" /></div>
								<div class="col-md-8"><label class="form-label" asp-for="OrgStreet">Logradouro</label><input class="form-control" asp-for="OrgStreet" /></div>
								<div class="col-md-4"><label class="form-label" asp-for="OrgNumber">Número</label><input class="form-control" asp-for="OrgNumber" /></div>
								<div class="col-md-8"><label class="form-label" asp-for="OrgComplement">Complemento</label><input class="form-control" asp-for="OrgComplement" /></div>
								<div class="col-md-4"><label class="form-label" asp-for="OrgState">UF</label><input class="form-control" asp-for="OrgState" maxlength="2" /></div>
								<div class="col-12 d-flex justify-content-end gap-2 mt-2 pt-3 border-top">
									<button class="btn btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#organizationEdit">Cancelar</button>
									<button class="btn btn-primary" type="submit">Salvar alterações</button>
								</div>
							</form>
							<datalist id="org-segments">
								<option value="Tecnologia" /><option value="Serviços" /><option value="Indústria" /><option value="Comércio" />
							</datalist>
						</div>
					</div>
				</div>
			}
		</div>

		<div class="tab-pane fade @(IsTab("branches") ? "show active" : null)" id="branches" role="tabpanel" aria-labelledby="tab-branches" tabindex="0">
			<div class="d-flex flex-wrap justify-content-between gap-2 mb-3">
				<div>
					<h2 class="h5 fw-bold mb-1">Rede de branches</h2>
					<p class="small text-secondary mb-0">Cada branch é uma unidade (matriz ou filial) com CNPJ próprio, produtos e usuários.</p>
				</div>
				@if (Model.CanManageBranches)
				{
					<button class="btn btn-primary btn-sm" type="button" id="btnAddBranchTab">Adicionar branch</button>
				}
			</div>
			@if (Model.CanManageBranches)
			{
				<div class="collapse @(Model.BranchEditId.HasValue ? "show" : "") mb-4" id="branchCreate">
					<div class="card border bg-body-tertiary">
						<div class="card-body">
							<h3 class="h6 fw-bold mb-3">@(Model.BranchEditId.HasValue ? "Editar branch" : "Nova branch")</h3>
							<form method="post" asp-page-handler="@(Model.BranchEditId.HasValue ? "UpdateBranch" : "CreateBranch")" class="row g-3">
								<input type="hidden" asp-for="Id" />
								<input type="hidden" asp-for="BranchEditId" />
								<div class="col-md-6"><label class="form-label" asp-for="BranchName">Nome (exibição)</label><input class="form-control" asp-for="BranchName" required /></div>
								<div class="col-md-6"><label class="form-label" asp-for="BranchCode">Código</label><input class="form-control" asp-for="BranchCode" required /></div>
								<div class="col-md-6"><label class="form-label" asp-for="BranchLegalName">Razão social</label><input class="form-control" asp-for="BranchLegalName" /></div>
								<div class="col-md-6"><label class="form-label" asp-for="BranchTradeName">Nome fantasia</label><input class="form-control" asp-for="BranchTradeName" /></div>
								<div class="col-md-6"><label class="form-label" asp-for="BranchTaxId">CNPJ</label><input class="form-control" asp-for="BranchTaxId" placeholder="00.000.000/0000-00" /></div>
								<div class="col-md-6"><label class="form-label" asp-for="BranchSegment">Segmento</label><input class="form-control" asp-for="BranchSegment" /></div>
								<div class="col-12"><label class="form-label" asp-for="BranchDescription">Descrição</label><textarea class="form-control" asp-for="BranchDescription" rows="2"></textarea></div>
								<div class="col-12"><h4 class="h6 fw-bold mb-0">Endereço</h4></div>
								<div class="col-md-4"><label class="form-label" asp-for="BranchPostalCode">CEP</label><input class="form-control" asp-for="BranchPostalCode" /></div>
								<div class="col-md-8"><label class="form-label" asp-for="BranchCity">Cidade</label><input class="form-control" asp-for="BranchCity" /></div>
								<div class="col-md-8"><label class="form-label" asp-for="BranchStreet">Logradouro</label><input class="form-control" asp-for="BranchStreet" /></div>
								<div class="col-md-4"><label class="form-label" asp-for="BranchNumber">Número</label><input class="form-control" asp-for="BranchNumber" /></div>
								<div class="col-md-8"><label class="form-label" asp-for="BranchComplement">Complemento</label><input class="form-control" asp-for="BranchComplement" /></div>
								<div class="col-md-4"><label class="form-label" asp-for="BranchState">UF</label><input class="form-control" asp-for="BranchState" maxlength="2" /></div>
								<div class="col-12 d-flex justify-content-end gap-2 mt-2 pt-3 border-top">
									@if (Model.BranchEditId.HasValue)
									{
										<a class="btn btn-outline-secondary" asp-route-id="@Model.Id" asp-fragment="branches">Cancelar</a>
									}
									else
									{
										<button class="btn btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#branchCreate">Cancelar</button>
									}
									<button class="btn btn-primary" type="submit">@(Model.BranchEditId.HasValue ? "Salvar alterações" : "Adicionar branch")</button>
								</div>
							</form>
						</div>
					</div>
				</div>
			}
			@if (Model.Branches.Count == 0)
			{
				<p class="text-secondary mb-0">Nenhuma filial.</p>
			}
			else
			{
				<div class="d-flex flex-column gap-3">
					@foreach (var b in Model.Branches)
					{
						var branchAddress = PartyAddressFormatting.FormatAddress(b.PostalCode, b.Street, b.Number, b.Complement, b.City, b.State);
						<div class="card branch-card @(b.ParentBranchId is null ? "is-hq" : "is-child") border">
							<div class="card-body d-flex flex-wrap gap-3 align-items-start">
								<span class="entity-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 20V8l8-4 8 4v12" /><path d="M9 20v-6h6v6" /></svg></span>
								<div class="flex-grow-1">
									<div class="d-flex flex-wrap align-items-center gap-2 mb-1">
										<strong>@(string.IsNullOrWhiteSpace(b.TradeName) ? b.Name : b.TradeName)</strong>
										<span class="badge @(b.ParentBranchId is null ? "text-bg-info" : "text-bg-secondary")">@(b.ParentBranchId is null ? "Matriz" : "Filial")</span>
									</div>
									<p class="small text-secondary mb-1">
										@b.Code
										@if (!string.IsNullOrWhiteSpace(b.TaxId)) { <span> · CNPJ @b.TaxId</span> }
										@if (!string.IsNullOrWhiteSpace(b.City)) { <span> · @b.City@(string.IsNullOrWhiteSpace(b.State) ? "" : $"/{b.State}")</span> }
									</p>
									@if (!string.IsNullOrWhiteSpace(branchAddress))
									{
										<p class="small text-secondary mb-0">@branchAddress</p>
									}
								</div>
								@if (Model.CanManageBranches)
								{
									<a class="btn btn-link btn-sm" asp-route-id="@Model.Id" asp-route-BranchEditId="@b.Id" asp-fragment="branches">Editar</a>
								}
							</div>
						</div>
					}
				</div>
			}
		</div>

		<div class="tab-pane fade @(IsTab("contato") ? "show active" : null)" id="contato" role="tabpanel" aria-labelledby="tab-contato" tabindex="0">
			<div class="d-flex flex-wrap justify-content-between gap-2 mb-3">
				<div>
					<h2 class="h5 fw-bold mb-1">Contatos da empresa</h2>
					<p class="small text-secondary mb-0">Responsáveis e canais de atendimento.</p>
				</div>
			</div>
			@{
				var primary = Model.Contacts.FirstOrDefault(c => c.IsPrimary) ?? Model.Contacts.FirstOrDefault();
			}
			@if (primary is not null)
			{
				<h3 class="h6 text-secondary text-uppercase mb-3" style="letter-spacing: 0.04em">Contato principal</h3>
				<dl class="row mb-4">
					<dt class="col-sm-3 text-secondary small">Responsável</dt><dd class="col-sm-9">@primary.Name</dd>
					<dt class="col-sm-3 text-secondary small">Cargo</dt><dd class="col-sm-9">@(string.IsNullOrWhiteSpace(primary.Title) ? "—" : primary.Title)</dd>
					<dt class="col-sm-3 text-secondary small">E-mail</dt><dd class="col-sm-9">@(string.IsNullOrWhiteSpace(primary.Email) ? "—" : primary.Email)</dd>
					<dt class="col-sm-3 text-secondary small">Telefone</dt><dd class="col-sm-9">@(string.IsNullOrWhiteSpace(primary.Phone) ? "—" : primary.Phone)</dd>
				</dl>
			}
			@if (Model.CanManageContacts)
			{
				<form method="post" asp-page-handler="SaveContact" class="row g-2 mb-4" style="max-width: 44rem">
					<input type="hidden" asp-for="Id" />
					<input type="hidden" asp-for="ContactEditId" />
					<div class="col-md-6">
						<label class="form-label" asp-for="ContactName">Nome</label>
						<input class="form-control" asp-for="ContactName" required />
					</div>
					<div class="col-md-6">
						<label class="form-label" asp-for="ContactTitle">Cargo</label>
						<input class="form-control" asp-for="ContactTitle" />
					</div>
					<div class="col-md-6">
						<label class="form-label" asp-for="ContactEmail">E-mail</label>
						<input class="form-control" asp-for="ContactEmail" type="email" />
					</div>
					<div class="col-md-6">
						<label class="form-label" asp-for="ContactPhone">Telefone</label>
						<input class="form-control" asp-for="ContactPhone" />
					</div>
					<div class="col-12">
						<div class="form-check">
							<input class="form-check-input" asp-for="ContactIsPrimary" />
							<label class="form-check-label" asp-for="ContactIsPrimary">Contato principal</label>
						</div>
					</div>
					<div class="col-12 d-flex justify-content-end gap-2 mt-2 pt-3 border-top">
						@if (Model.ContactEditId.HasValue)
						{
							<a class="btn btn-outline-secondary" asp-route-id="@Model.Id" asp-fragment="contato">Cancelar</a>
						}
						<button class="btn btn-primary" type="submit">@(Model.ContactEditId.HasValue ? "Salvar contato" : "Adicionar contato")</button>
					</div>
				</form>
			}
			@if (Model.Contacts.Count == 0)
			{
				<p class="text-secondary mb-0">Nenhum contato cadastrado.</p>
			}
			else
			{
				<div class="d-flex flex-column gap-3">
						@foreach (var c in Model.Contacts)
						{
							<div class="card border">
								<div class="card-body d-flex flex-wrap gap-3 align-items-start">
									<span class="entity-icon" aria-hidden="true"><i class="fa-regular fa-address-card"></i></span>
									<div class="flex-grow-1">
										<div class="d-flex flex-wrap align-items-center gap-2 mb-1">
											<strong>@c.Name</strong>
											@if (c.IsPrimary) { <span class="badge text-bg-info">Principal</span> }
										</div>
										<p class="small text-secondary mb-1">@(c.Title ?? "Contato")</p>
										<div class="d-flex flex-wrap gap-3 small">
											@if (!string.IsNullOrWhiteSpace(c.Email)) { <a href="mailto:@c.Email">@c.Email</a> }
											@if (!string.IsNullOrWhiteSpace(c.Phone)) { <span class="text-secondary">@c.Phone</span> }
										</div>
									</div>
									@if (Model.CanManageContacts)
									{
										<div class="table-actions">
											<a class="btn btn-link btn-sm" asp-route-id="@Model.Id" asp-route-ContactEditId="@c.Id" asp-fragment="contato">Editar</a>
											<form method="post" asp-page-handler="DeleteContact" class="d-inline">
												<input type="hidden" name="contactId" value="@c.Id" />
												<input type="hidden" asp-for="Id" />
												<button class="btn btn-link btn-sm text-danger" type="submit">Excluir</button>
											</form>
										</div>
									}
								</div>
							</div>
						}
				</div>
			}
		</div>

		<div class="tab-pane fade @(IsTab("produtos") ? "show active" : null)" id="produtos" role="tabpanel" aria-labelledby="tab-produtos" tabindex="0">
			<div class="d-flex flex-wrap justify-content-between gap-3 mb-3">
				<div>
					<h2 class="h5 fw-bold mb-1">Produtos associados</h2>
					<p class="small text-secondary mb-0">Habilitações vigentes para esta empresa. Edição avançada por branch fica em Admin → Habilitações.</p>
				</div>
				@if (Model.IsAdminRoute)
				{
					<a class="btn btn-outline-secondary btn-sm" asp-area="Admin" asp-page="/ProductEnablements">Gerenciar habilitações</a>
				}
			</div>
			@if (Model.Products.Count == 0)
			{
				<p class="text-secondary mb-0">Nenhum produto habilitado para esta empresa.</p>
			}
			else
			{
				<div class="d-flex flex-column gap-3">
					@foreach (var p in Model.Products)
					{
						<div class="card product-row is-enabled border" data-product-row>
							<div class="card-body d-flex flex-wrap align-items-center gap-3">
								<span class="entity-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="8" cy="8" r="2.5" /><circle cx="16" cy="8" r="2.5" /><circle cx="12" cy="16" r="2.5" /><path d="M10 9.5 11 14M14 9.5 13 14M10 8h4" /></svg></span>
								<div class="flex-grow-1">
									<strong>@p.Name</strong>
									<div class="small text-secondary">@p.Code · escopo da organização</div>
								</div>
								<div class="form-check form-switch mb-0">
									<input class="form-check-input" type="checkbox" role="switch" checked disabled />
									<label class="form-check-label">Liberado</label>
								</div>
							</div>
						</div>
					}
				</div>
			}
		</div>

		<div class="tab-pane fade @(IsTab("usuarios") ? "show active" : null)" id="usuarios" role="tabpanel" aria-labelledby="tab-usuarios" tabindex="0">
			<div class="d-flex flex-wrap justify-content-between gap-3 mb-3">
				<div>
					<h2 class="h5 fw-bold mb-1">Usuários da empresa</h2>
					<p class="small text-secondary mb-0">Membros com vínculo (membership) nesta organização.</p>
				</div>
				@if (Model.CanViewMembers && Model.IsAdminRoute)
				{
					<a class="btn btn-primary btn-sm" asp-area="Admin" asp-page="/Invites">Convidar usuário</a>
				}
			</div>
			@if (!Model.CanViewMembers)
			{
				<p class="text-secondary mb-0">Você não tem permissão para listar usuários desta empresa.</p>
			}
			else if (Model.Members.Count == 0)
			{
				<p class="text-secondary mb-0">Nenhum membro.</p>
			}
			else
			{
				<div class="border rounded overflow-hidden bg-white">
					<div class="table-responsive">
						<table class="table table-hover align-middle mb-0">
							<thead>
								<tr>
									<th>Usuário</th>
									<th>Perfis</th>
									<th>Status</th>
								</tr>
							</thead>
							<tbody>
							@foreach (var m in Model.Members)
							{
								var label = !string.IsNullOrWhiteSpace(m.DisplayName) ? m.DisplayName! : m.Email;
								var initials = string.Concat(label.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpperInvariant(p[0])));
								if (string.IsNullOrEmpty(initials)) { initials = "?"; }
								<tr>
									<td>
										<div class="d-flex align-items-center gap-2">
											<span class="user-avatar">@initials</span>
											<div>
												<span class="fw-semibold">@label</span>
												<div class="small text-secondary">@m.Email</div>
											</div>
										</div>
									</td>
									<td>
										@if (m.Roles.Count == 0)
										{
											<span class="text-secondary">—</span>
										}
										else
										{
											@foreach (var role in m.Roles)
											{
												<span class="badge rounded-pill tag-role">@role</span>
											}
										}
									</td>
									<td><span class="badge text-bg-success">Ativo</span></td>
								</tr>
							}
							</tbody>
						</table>
					</div>
				</div>
			}
		</div>
	</div>
</div>
}
<script>
(function () {
	function showTab(id) {
		var trigger = document.getElementById('tab-' + id);
		if (trigger && window.bootstrap) {
			bootstrap.Tab.getOrCreateInstance(trigger).show();
		}
	}
	function openCollapse(id) {
		var el = document.getElementById(id);
		if (el && window.bootstrap) {
			bootstrap.Collapse.getOrCreateInstance(el, { toggle: false }).show();
			el.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
		}
	}
	document.getElementById('btnEditOrganization')?.addEventListener('click', function () {
		showTab('dados');
		openCollapse('organizationEdit');
	});
	document.getElementById('btnNewBranch')?.addEventListener('click', function () {
		showTab('branches');
		openCollapse('branchCreate');
	});
	document.getElementById('btnAddBranchTab')?.addEventListener('click', function () {
		openCollapse('branchCreate');
	});
	@if (Model.BranchEditId.HasValue)
	{
		<text>openCollapse('branchCreate');</text>
	}
	@if (Model.ContactEditId.HasValue)
	{
		<text>document.getElementById('ContactName')?.focus();</text>
	}
})();
</script>
